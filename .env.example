# ─────────────────────────────────────────────
# Motherson CRMS — Environment Configuration
# Copy this file to .env and fill in all values
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Oracle Instant Client — Required for NNE/Thick mode (ORA-12660)
# Download: https://www.oracle.com/database/technologies/instant-client/winx64-64-downloads.html
ORACLE_CLIENT_LIB=C:\Oracle\instantclient_21_3

# Oracle Database
DB_USER=crms_user
DB_PASSWORD=your_secure_password_here
DB_CONNECTION_STRING=localhost:1521/ORCL
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=1
DB_POOL_TIMEOUT=60

# JWT Auth
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_string
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:8080,null,https://crms.motherson.com

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# Sequence seeds (set to match your Oracle sequences if migrating)
RELEASE_SEQ_START=11972
TASK_SEQ_START=15932

# ─────────────────────────────────────────────
# ServiceNow Integration
# ─────────────────────────────────────────────
# Set SNOW_INSTANCE to enable. Leave blank to disable.
# Format: your-instance.service-now.com  (NO https://)

# Your ServiceNow instance hostname
SNOW_INSTANCE=your-instance.service-now.com

# Auth type: basic (simpler) or oauth (recommended for production)
SNOW_AUTH_TYPE=basic

# ServiceNow user credentials (needs itil + change_manager roles)
SNOW_USERNAME=crms_integration
SNOW_PASSWORD=your_snow_password

# OAuth 2.0 (only needed if SNOW_AUTH_TYPE=oauth)
# Create in SNow: System OAuth > Application Registry > New
SNOW_CLIENT_ID=
SNOW_CLIENT_SECRET=

# Shared secret for validating incoming webhooks from ServiceNow
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SNOW_WEBHOOK_SECRET=generate_a_random_32_char_secret_here

# Set to false to disable On Hold / Cancelled state syncing
SNOW_SYNC_ON_HOLD=true

# Set to true to log all SNow calls without actually sending them (testing)
SNOW_DRY_RUN=false

# ─────────────────────────────────────────────
# SMTP Email — CRMS notifications (approval, assignment, defaulted-task mail)
# Sent directly from Node via nodemailer — no Oracle package involved.
# ─────────────────────────────────────────────
SMTP_HOST=your.smtp.relay.or.exchange.host
SMTP_PORT=25
# true only if your relay requires implicit TLS on connect (usually port 465).
# Most internal relays on port 25/587 use STARTTLS automatically — leave false.
SMTP_SECURE=false
# Most internal relays allow anonymous relay from trusted internal IPs and
# need no auth — set true and fill SMTP_USER/SMTP_PASS only if yours requires it.
SMTP_REQUIRE_AUTH=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=crms-noreply@yourdomain.com
SMTP_FROM_NAME=CRMS Notification

# ─────────────────────────────────────────────
# Email one-click Approve/Reject — signs the token embedded in the email
# links (src/controllers/emailActionController.js). Separate from JWT_SECRET
# so these short-lived, single-purpose tokens don't share a key with login
# sessions. Falls back to JWT_SECRET if left unset.
# ─────────────────────────────────────────────
EMAIL_ACTION_SECRET=replace_with_a_long_random_secret_string_min_32_chars
EMAIL_ACTION_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# Resource Bandwidth digest (src/services/bandwidthDigestChecker.js) — a
# scheduled email of the Resource Bandwidth heatmap (open FSD/Testing/UAT
# load by week and month). Off by default — set recipients to turn it on.
# Schedule is a placeholder until finalized; change any of these anytime,
# no code change needed, next hourly check picks it up.
# ─────────────────────────────────────────────
BANDWIDTH_DIGEST_RECIPIENTS=
BANDWIDTH_DIGEST_FREQUENCY=weekly
BANDWIDTH_DIGEST_DAY=1
BANDWIDTH_DIGEST_HOUR=8
BANDWIDTH_DIGEST_DAY_OF_MONTH=1
